# Local demo only. Never use this password for a shared server.
DATABASE_URL=postgresql://kfarm:kfarm_local_demo@127.0.0.1:55432/kfarm
SOLVER_URL=http://127.0.0.1:8100
# Empty keeps loopback-only request origins. A hosted installation must explicitly
# set one canonical HTTPS origin, for example https://your-approved-domain.example
# This does not deploy or expose a server. Do not use NEXT_PUBLIC_ for this setting.
KFARM_APP_ORIGIN=
# Explicit opt-in; demo mode never sends requests to Nebius.
AI_MODE=demo
# Dedicated public judge login only. Keep disabled in ordinary operating databases.
# Supply a NEW public trial password at deployment; never reuse an admin password.
KFARM_JUDGE_ACCESS=0
KFARM_JUDGE_USERNAME=
KFARM_JUDGE_PASSWORD=
KFARM_JUDGE_CENTER_ID=
# Queue-only SMS reminder worker, every minute. Does not deliver real SMS.
# Set to 1 on the running server; 0 keeps manual Refresh available in Settings.
KFARM_SMS_WORKER=0
# A long-lived Node server checks new registrations every minute. Paid AI is
# opt-in; existing budget guards apply. Plans still require operator confirmation.
KFARM_PRODUCTION_WORKER=1
KFARM_PRODUCTION_AI=0
KFARM_LABOR_WORKER=1
# Decisions only: no inference on page loads, initial calculation or preview/approval.
AI_CALL_SCOPE=decisions
# Optional server-only shared billing ledger for isolated acceptance databases.
# Leave blank in normal operation; never create a fresh allowance per test.
AI_BUDGET_DATABASE_URL=
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
# Optional actual KMA observations; use the decoded public-data service key.
# Keep real values in .env.local, not source control. Confirm the target grid first.
KMA_SERVICE_KEY=
# aT daily wholesale/retail prices, approved data.go.kr development account.
AT_PRICE_SERVICE_KEY=
# Enable on one or more server processes; a shared daily lease deduplicates work.
KFARM_PRICE_WORKER=0
KMA_GRID_NX=
KMA_GRID_NY=
# Set only after verifying the weather grid for each new center.
KMA_JANGGYE_GRID_NX=
KMA_JANGGYE_GRID_NY=
KMA_CHEONCHEON_GRID_NX=
KMA_CHEONCHEON_GRID_NY=
KMA_GYENAM_GRID_NX=
KMA_GYENAM_GRID_NY=
# VWorld parcel search and boundary lookup. Set actual values only in .env.local.
VWORLD_API_KEY=
VWORLD_DOMAIN=http://127.0.0.1:3100
# Optional server-side, independently obtained provider samples; not public source.
# Blank uses .data/provider-samples, with existing legacy files kept compatible.
KFARM_PROVIDER_DATA_DIR=
